# Zugangsdaten für den Formularversand.
# In Vercel unter Settings → Environment Variables hinterlegen
# (nicht in dieser Datei eintragen — sie liegt im Repository).

# Postfach, über das die Anfragen versendet werden (IONOS).
SMTP_HOST=smtp.ionos.de
SMTP_USER=info@sim-immoservice.de
SMTP_PASS=

# Optional — die Standardwerte passen für IONOS:
# SMTP_PORT=465
# SMTP_SECURE=true
# MAIL_TO=info@sim-immoservice.de

# Wartungssteuerung
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ADMIN_PASS=
ADMIN_SECRET=
